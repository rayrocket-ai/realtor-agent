# ============================================================
# realtor-agent configuration
# Copy to .env and fill in. scripts/bootstrap.sh generates the
# random secrets for you and prompts for the API keys.
# ============================================================

# --- Domain / server ---
# Point a DNS A record for this domain at your Hetzner server's IP first.
DOMAIN=agent.example.com
APP_BASE_URL=https://agent.example.com

# --- Admin dashboard (basic auth) ---
ADMIN_USER=ray
ADMIN_PASSWORD=change-me            # bootstrap.sh generates one if left blank

# --- Secrets ---
APPROVAL_TOKEN_SECRET=change-me     # random string; bootstrap.sh generates

# --- Postgres ---
POSTGRES_PASSWORD=change-me         # bootstrap.sh generates
DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@db:5432/realtor

# --- Anthropic (console.anthropic.com -> API keys) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Google ---
# Create a Google Cloud project, enable the Gmail API and Google Calendar API,
# create an OAuth client of type "Desktop app", then run:  npm run auth:google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=               # produced by `npm run auth:google`
GOOGLE_CALENDAR_NAME=Real Estate    # calendar showings are booked into
# GOOGLE_CALENDAR_ID=               # optional: set to skip name lookup
GMAIL_ADDRESS=r4166252070@gmail.com

# Gmail intake mode:
#   label = only reply on threads labeled AI-Handle (safe default)
#   all   = reply to any inbound email that looks like a lead
GMAIL_MODE=label
GMAIL_LABEL=AI-Handle

# --- Boosend (WhatsApp / Instagram DMs) ---
# Set the webhook in Boosend to: https://<DOMAIN>/webhooks/boosend
# and use the same secret below.
BOOSEND_API_KEY=
BOOSEND_WEBHOOK_SECRET=
BOOSEND_API_BASE=https://api.boosend.com/v1

# --- Realtor identity (used in prompts and AI disclosure) ---
REALTOR_NAME=Ray
REALTOR_BROKERAGE=eXp Realty
REALTOR_EMAIL=r4166252070@gmail.com
REALTOR_PHONE=

# --- Scheduling ---
WORKING_HOURS=09:00-20:00
TZ=America/Toronto

# --- REALM (PropTx MLS) + BrokerBay showing bookings ---
# With these set, "book 36 Example Ave tomorrow 2pm" searches REALM for the
# listing, follows its Book Showing button into BrokerBay, and books the slot.
# Leave REALM_USERNAME empty to disable MLS-side booking entirely.
REALM_URL=https://hub.proptx.ca
REALM_USERNAME=
REALM_PASSWORD=
# Who sends REALM's one-time codes (phone number or email address). The agent
# reads the code automatically from HighLevel (below) or Gmail; you can also
# paste it into the box on /admin/bookings while a booking waits.
REALM_OTP_SENDER=
# If the code lands on a HighLevel (GoHighLevel) line, set these and the agent
# grabs it from the conversation automatically (Private Integration token).
HIGHLEVEL_API_TOKEN=
HIGHLEVEL_LOCATION_ID=
# Only needed if BrokerBay asks for its own sign-in instead of REALM SSO:
BROKERBAY_EMAIL=
BROKERBAY_PASSWORD=
# BOOKING_DRY_RUN=1                 # do everything except the final submit (recommended for first tests)
# BOOKING_HEADLESS=0                # show the browser (for `npm run booking:login` 2FA over ssh -X)
# BOOKING_DEFAULT_DURATION_MIN=30
# BOOKING_DATA_DIR=./data/booking   # login session + screenshots live here

# --- Optional ---
PORT=3000
LOG_LEVEL=info
# MOCK_ANTHROPIC=1                  # dev only: canned agent replies, no API calls
