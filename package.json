{
  "name": "realtor-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "24/7 AI real estate assistant: books showings, drafts offers (human-approved), nurtures leads over Gmail + WhatsApp/Instagram (Boosend).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "auth:google": "tsx src/cli/google-auth.ts",
    "send-test": "tsx src/cli/send-test.ts",
    "audit": "tsx src/cli/audit.ts",
    "telegram:setup": "tsx src/cli/telegram-setup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@fastify/basic-auth": "^6.0.1",
    "@fastify/formbody": "^8.0.1",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.2.0",
    "googleapis": "^144.0.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
